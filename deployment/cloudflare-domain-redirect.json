{
  "ref": "nineai_canonical_host",
  "description": "Nine.ai: Weiterleitung auf die HTTPS-Hauptdomain",
  "expression": "(http.host eq \"nineai.de\") or (http.host eq \"www.nineai.de\" and not ssl)",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 308,
      "target_url": {
        "expression": "concat(\"https://www.nineai.de\", raw.http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
